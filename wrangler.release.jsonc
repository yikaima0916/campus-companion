{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campus-companion",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campus-companion",
      "database_id": "d4251b8d-5408-483a-8a51-6b1fa79967c6",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "keep_vars": true,
  "workers_dev": true
}
